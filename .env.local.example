# ==========================================
# MRIYII (WishJar) — Environment Variables
# ==========================================

# 1. MongoDB Atlas Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/mriyii?retryWrites=true&w=majority"

# 2. Firebase Authentication (Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:abcdef123456"

# 3. Firebase Admin SDK (Server-Side Token Verification)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 4. Google Gemini API (@google/genai — gemini-2.5-flash)
GEMINI_API_KEY="your-gemini-api-key"

# 5. Affiliate Networks & Monetization
ADMITAD_PUBLISHER_ID="your-admitad-publisher-id"
ROZETKA_AFFILIATE_TAG="your-rozetka-affiliate-tag"

# 6. Base Application URL (for OpenGraph & Short Links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
